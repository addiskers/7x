GEMINI_API_KEY=
# Must be a valid Gemini Live model id for your account + installed SDK. A warm,
# low-latency half-cascade/flash-live model is recommended for this RSVP bot.
MODEL=gemini-3.1-flash-live-preview

# ---- Call script ----
# There is no script env var. What the agent says is a per-agent TEMPLATE stored in the
# database and edited in the Agents tab; each call renders it against its wedding, event
# and guest. The language rule lives in the template too (the shipped agents open in
# English and switch to Hinglish when the guest does).

# ---- Voice ----
# Voice language bias for Gemini's speech output (BCP-47), fixed per session. en-IN = Indian-English
# accent; the native-audio model can still speak Hindi/Gujarati under it — verify quality on a live call.
EO_SPEECH_LANGUAGE_CODE=en-IN
# Expressiveness: lets the model read the caller's tone and answer with matching emotion instead of a flat
# read (native-audio models only). Try it on the TEST box first — an unsupported model rejects the session.
EO_AFFECTIVE_DIALOG=false
# Voice: Aoede (default, warm female). Others to A/B on the test box: Kore, Leda, Zephyr — no code change.
# EO_VOICE_NAME=Aoede

# ---- Personalisation ----
# Optional phone->first-name directory so the agent greets members by name
# ("Hello Pratik!"). CSV columns: phone,first_name  (or a JSON map). This file is
# PII — keep it out of version control. A per-call "name" (via /call-me) overrides it.
MEMBER_DIRECTORY_PATH=data/members.csv

# ---- Plivo (phone calls) ----
# From your Plivo console. PLIVO_FROM_NUMBER must be a Plivo number you own (E.164).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
# Public https URL Plivo can reach for the /plivo/answer webhook (e.g. an ngrok tunnel).
PUBLIC_URL=

# ---- Call behaviour ----
# Safety cap: hang up any call that runs longer than this many seconds (the agent
# normally ends the call itself via the end_call tool right after its goodbye).
CALL_MAX_SECONDS=420
# Gentle pause (seconds) AFTER the goodbye audio has fully drained, before hanging up,
# so the call never cuts off mid-word. Raise it if endings feel abrupt.
CALL_HANGUP_GRACE_SECONDS=0.5
# After the agent says goodbye (end_call), how long to keep listening in case the
# member wants to continue. If they speak, the hangup is cancelled and the call goes
# on. Together with CALL_HANGUP_GRACE_SECONDS this sets the post-goodbye dead air
# (~1.5s after the last word at these defaults — longer and members say "hello?" into
# the silence). Raise it to give members more time to jump back in.
CALL_END_GRACE_SECONDS=1
# Never cut the caller off mid-sentence: inbound audio is watched in real time (a VAD
# energy gate) so activity registers before transcription catches up.
EO_VAD_RMS_THRESHOLD=500              # inbound voice gate; silence ~0, comfort-noise ~6, speech >~1000
EO_HANGUP_ABORT_WINDOW_SECONDS=1.2   # abort a pending hangup if the caller voiced this recently
# Once the goodbye has been said, a voice abort of the hangup is allowed this many times (a member who
# starts a REAL question is saved once); after that a bare "hello?" / "ok" ends the call, muted.
EO_HANGUP_ABORT_MAX=1
EO_HOLD_GRACE_SECONDS=30             # keep the line open this long after "hold on / give me a minute"
EO_POST_RSVP_IDLE_SECONDS=12         # quiet window after the RSVP before auto-hangup
# Call recording: mix caller+agent into one mono 8kHz WAV per call (DATA_DIR/recordings/<call_sid>.wav),
# played back from the admin call drawer. ~16 KB/s (~3 MB per 3-min call). Set false to disable.
EO_RECORD_CALLS=true
EO_RECORD_MAX_SECONDS=420            # cap a single recording's length (matches CALL_MAX_SECONDS)
# ---- Reply latency (Gemini server VAD — tune on prod, watch the "TURN LATENCY" log lines) ----
# How much caller silence ends their turn. THE biggest lever on reply delay: lower =
# snappier replies but more risk of cutting slow speakers. 400-550 is the sane range.
EO_VAD_SILENCE_MS=550
EO_VAD_PREFIX_MS=250                 # committed speech required before a turn opens (anti click/echo)
EO_VAD_START_SENSITIVITY=LOW         # LOW = anti-echo on phone lines; HIGH = catches softer starts
# HIGH is the next lever if one-word replies ("yes", "hello") keep going unanswered until the
# missed-reply rescue: it opens a turn on softer starts, at the price of echo phantoms. Not
# tried on a live campaign yet — test-call it first.
EO_VAD_END_SENSITIVITY=HIGH          # HIGH = snappy end-of-turn; LOW = more patient
# ---- Barge-in / mid-sentence silence guards (plivo_handler) ----
# A Gemini "interrupted" is honoured (agent audio flushed) only if the caller was genuinely voicing:
# at least EO_INTERRUPT_MIN_VOICED_MS of voiced frames inside the last EO_INTERRUPT_CONFIRM_WINDOW_S.
# Otherwise it is a click/echo phantom: playback is kept and the agent is asked to finish its sentence.
EO_INTERRUPT_CONFIRM_WINDOW_S=0.8
# Keep at 120. 350 was tried on 24 Sep 2026 and made calls worse: testers had to repeat
# themselves two or three times to interrupt, and an overruled interruption left the agent
# answering silently (the model had stopped, the bridge kept playing the old audio) and then
# restarting its sentence ("hey… hey…").
EO_INTERRUPT_MIN_VOICED_MS=120
EO_PHANTOM_RESUME_DELAY_S=1.2        # wait this long (no caller speech) before asking the agent to resume
EO_PHANTOM_RESUME_MAX=2              # resume nudges per call
# Repeat guard: when a closing phrase repeats inside ONE turn, drop the rest of that turn's NEW audio.
# true = ALSO flush what is already queued/playing (cuts the sentence the member is hearing — off by default).
EO_REPEAT_GUARD_FLUSH=false
EO_SUPPRESS_TURN_MAX_S=4             # the repeat mute self-expires after this many seconds
EO_MUTE_RECORD_NUDGE_DELAY_S=1.5     # wait before "say your closing" so it can't interrupt a closing already starting
# "Hello? hello?" storm: N short hellos within W seconds while the agent talks → one "can you hear me?" nudge
EO_HELLO_STORM_COUNT=3
EO_HELLO_STORM_WINDOW_S=15
EO_HELLO_STORM_MAX=2                 # nudges per call
EO_HELLO_STORM_COOLDOWN_S=30
EO_FAREWELL_WAIT_SECONDS=4           # head start for a still-generating goodbye before hangup drain
EO_AUDIO_INPUT_QUEUE_FRAMES=150      # inbound audio buffer to Gemini (drop-oldest past this, stays live)
# ---- Silence check ("are you still there?") ----
EO_SILENCE_CHECK=true
EO_SILENCE_PROMPT_SECONDS=6          # mutual silence before the agent asks "are you still there?"
EO_SILENCE_HANGUP_SECONDS=10         # further caller silence before a goodbye + hangup
EO_SILENCE_NUDGE_MAX=2               # max "are you still there?" asks per call
EO_SILENCE_NUDGE_COOLDOWN_S=15       # min gap between asks (noise blips can't re-trigger sooner)
# Missed-reply rescue: Gemini occasionally never registers a short caller reply ("yeah, hello") as a turn.
# Fast path: the caller finished speaking this many seconds ago and no agent audio followed → prompt it once.
# 2.5 shipped; 1.5 on the Ved & Riya server (25 Sep): with the three-line script a guest's
# reply is one word, and the tester counted 4-5s from "yes" to the next line.
EO_UNANSWERED_REPLY_SECONDS=2.5
# An open model turn with no new text or audio for this long counts as finished, so the
# rescue above may fire. It was a fixed 3s, which on top of the 2.5s made a mid-turn stall
# 5-7s long before anyone stepped in. 2 on the Ved & Riya server.
EO_TURN_EXPIRE_SECONDS=3
# Deaf path: the caller keeps voicing (hello? hello?) while the agent has been mute this long → prompt it once.
# 10, not 6: at 6 it fired while a guest was simply answering at length (25 Sep 02:06) and the
# schedule was read out twice. A guest saying "hello? hello?" for ten seconds is still caught.
EO_DEAF_RESCUE_SECONDS=10
# Greeting watchdog: if Gemini stalls on the opening line (server-side variance, the
# member hears only the connect melody), push it after this many seconds — and again every
# interval, up to EO_GREETING_NUDGE_MAX times. If it still has not spoken, the call is
# recorded not_reachable (the campaign redials it later) and hung up, instead of the 20s
# of dead air a tester sat through. Every call also logs "GREETING LATENCY: x.xx s".
EO_GREETING_NUDGE_SECONDS=4
EO_GREETING_NUDGE_MAX=3
# The connect melody plays until the agent's first audio or this many seconds (hard cap 20).
# Keep it at least the watchdog's whole window (SECONDS x MAX), so a slow opening is music,
# never silence.
EO_CONNECT_TONE_MAX_S=12
# ---- Noise squelch (background voices/noise) ----
# Replaces below-gate inbound audio with clean silence before Gemini hears it (never
# drops frames — the server VAD needs to hear the quiet). Reduces the agent replying to
# surrounding voices. START DISABLED; enable after a live-call check of barge-in and a
# soft-spoken caller. RMS gate: speech is typically >1000, room noise far lower.
EO_NOISE_GATE=false
EO_NOISE_GATE_RMS=250                # squelch gate (RMS) — keep LOWER than EO_VAD_RMS_THRESHOLD
EO_NOISE_GATE_HANGOVER_S=0.6         # keep passing audio this long after the last voiced frame
# ---- Calling hours (night hard-stop) ----
# Default window for callbacks with no campaign; per-campaign windows are set at creation.
# "HH:MM" in IST. No automated campaign/callback dials happen outside the window (manual
# "Call now" is always allowed).
EO_CALL_WINDOW_START=09:00
EO_CALL_WINDOW_END=21:00

# ---- Super-Admin dashboard (/superadmin) ----
# Shared key required to open /superadmin and call /api/admin/* (X-Admin-Key / ?key=)
ANALYTICS_SECRET=eo2026

# ---- EO Admin platform (the React /admin app) ----
# First admin user, seeded ONLY if the users table is empty. Change these in prod,
# then change the password again from the Profile page after first login.
EO_ADMIN_USER=eoadmin
EO_ADMIN_PASS=change-me-now
# Signing key for EO login tokens (any long random string). Falls back to ANALYTICS_SECRET.
EO_SESSION_SECRET=
# Global cap on simultaneous LIVE calls — campaign dials + callbacks SHARE this.
# When full, new campaign dials and due callbacks wait (queued) and fire when a
# slot frees; callbacks get first claim. Read at dial time, so .env works here.
# A wedding-day reminder burst has to clear hundreds of guests inside an hour, so this
# is 10 rather than the old 2. Watch a few live calls before turning it up further —
# it costs concurrent Gemini sessions and telephony spend.
MAX_LIVE_CALLS=10
# Campaign dialer pacing (optional; defaults shown)
# EO_CAMPAIGN_MAX_CONCURRENT=10    # max simultaneous campaign calls
# EO_CAMPAIGN_MAX_PER_TICK=3       # new dials started per 30s tick
# EO_CAMPAIGN_NOANSWER_SECONDS=90  # ring window before a dial counts as no-answer

# How many campaigns may be scheduled/live at once. The wedding day legitimately runs
# several in parallel (six reminder batches on one afternoon), which is why the old
# one-at-a-time rule became a cap. Dials are still gated by MAX_LIVE_CALLS above, and the
# runner rotates which campaign gets the first claim each tick so none is starved.
# EO_MAX_ACTIVE_CAMPAIGNS=6

# Creating a campaign warns when a guest was already called inside this window. It is a
# warning, never a block — the client's own schedule needs several calls to some guests
# on the wedding day. 0 disables the check.
# EO_FATIGUE_WINDOW_HOURS=12

# Lifetime of the signed token the Agents tab mints for a browser-mic test. Short on
# purpose: it names one agent/event/guest, and /ws is otherwise unauthenticated.
# EO_TEST_TOKEN_TTL=300

# ---- Call log + cost storage ----
# JSON call records are written to DATA_DIR/calls/<id>.json.
DATA_DIR=

# ---- Gemini cost rates (USD per 1,000,000 tokens, paid tier) ----
RATE_GEMINI_TEXT_IN=0.75
RATE_GEMINI_AUDIO_IN=3.00
RATE_GEMINI_IMGVID_IN=1.00
RATE_GEMINI_TEXT_OUT=4.50
RATE_GEMINI_AUDIO_OUT=12.00

# ---- Telephony fallback rate (USD per minute) ----
RATE_TWILIO_PER_MIN=0.014

# ---- Auto-callback scheduler (re-dials members who asked to be called back) ----
# Set ENABLED=false to capture/queue callbacks without dialing (e.g. while Plivo
# outbound is still KYC-blocked). All others are optional; defaults shown.
CALLBACK_SCHEDULER_ENABLED=true
CALLBACK_POLL_INTERVAL=30          # seconds between scheduler ticks
CALLBACK_DEFAULT_OFFSET=7200       # default callback delay (s) when no time given (2h)
CALLBACK_MIN_DELAY=60              # floor — never schedule in the past
CALLBACK_MAX_HORIZON=604800        # ceiling on how far out (7 days)
CALLBACK_MAX_ATTEMPTS=3            # dial attempts before marking failed
CALLBACK_BACKOFF_BASE=300          # retry backoff base (s), doubles per attempt
CALLBACK_BACKOFF_MAX=3600          # retry backoff cap (s)
CALLBACK_MAX_PER_TICK=5            # max dials initiated per tick
CALLBACK_DIAL_TIMEOUT=60           # max seconds to wait on a single dial before failing it
CALLBACK_FAILFAST_THRESHOLD=5      # consecutive failures that trip the breaker
CALLBACK_FAILFAST_COOLDOWN=1800    # breaker pause (s) — survives restarts
CALLBACK_MAX_GENERATIONS=1         # cap on callback->callback chains
CALLBACK_TZ=Asia/Kolkata           # timezone for parsing spoken/default times

# ---------------------------------------------------------------------------------------
# Service-provider accounts, above eo_admin. Only these usernames can clear data or change
# the plan (Super admin page). A client may legitimately hold an eo_admin login, and wiping
# the database must never come with it. Blank = nobody, which is the safe default.
EO_SUPERADMIN_USERS=

# The agent a guest reaches by dialling one of OUR numbers (Plivo Answer URL =
# https://<PUBLIC_URL host>/plivo/answer). Only for cold inbound calls with no campaign
# history; a call-back to a campaign we ran keeps that campaign's agent. If this agent is
# switched off, the call falls back to the shipped reminder agent. A one-function agent
# here (event_reminder, the strict three-line script) speaks about the next function to
# start — never one already under way. Code default: wedding_schedule.
EO_INBOUND_AGENT_SLUG=event_reminder
# The function an inbound call on a one-function agent is about. Blank = the next function
# to start (before four it is the Hi-Tea, after seven the After Party); an event id pins it —
# "inbound is for the Sufi Night only, all day". Clear it after the wedding.
EO_INBOUND_EVENT_ID=

# Which tabs the client's admins see, until the super admin saves a choice in the UI.
# Comma-separated keys from: weddings, campaigns, contacts, scheduler, agents, call-logs,
# users, settings, subscription. Blank = show everything.
EO_HIDDEN_PAGES=agents

# The client's plan, shown on the Subscription page. Display only: nothing here blocks a
# call. A super admin can override these from the UI without a redeploy.
EO_PLAN_NAME=
EO_PLAN_MINUTES=0                    # 0 = no minute cap
EO_PLAN_START=                       # YYYY-MM-DD
EO_PLAN_END=
EO_LICENCE_VALID_TILL=
EO_RATE_INR_PER_MIN=

# Languages the CALLER's transcript is biased toward (call logs, language stats). This is
# the text copy only; the model hears the audio itself. Sent as language_hints ONLY: the
# Live API refuses a session that also sets language_auto (a 1007 that failed every call).
# Blank = the plain transcription config. Narrow it to what the wedding needs — the
# Ved & Riya server runs en-IN,hi-IN,gu-IN — so a Gujarati reply is never written down as
# something else, and the bridge's language check has a clean signal.
EO_TRANSCRIBE_LANGUAGE_HINTS=en-IN,hi-IN,gu-IN,mr-IN,pa-IN,bn-IN,ta-IN,te-IN,kn-IN,ml-IN
